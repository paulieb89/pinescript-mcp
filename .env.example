# ai-ready-data connection — required for semantic tools
# semantic_search_pine_docs and explain_pine_error use these.
# All existing deterministic tools (list_docs, resolve_topic, etc.) work without them.

# Base URL of the ai-ready-data service (no trailing slash)
AI_READY_BASE_URL=http://127.0.0.1:8000

# Dataset identifier in ai-ready-data
AI_READY_DATASET=pinescript-v06

# HTTP request timeout in seconds
AI_READY_TIMEOUT=10.0

# Default number of results to return from semantic search
AI_READY_TOP_K=5

# Optional: Bearer token for authenticated ai-ready-data instances
# Leave empty for unauthenticated local development
AI_READY_API_KEY=
